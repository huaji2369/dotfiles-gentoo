input {
    keyboard {
        numlock
	    repeat-delay 300
	    repeat-rate 60
    }
    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
        disabled-on-external-mouse
    }
    mouse {
        accel-profile "flat"
    }
}
output "eDP-1" {
    mode "1920x1080"
    scale 1
    transform "normal"
}
layout {
    gaps 4
    center-focused-column "never"
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    preset-window-heights {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    default-column-width {proportion 0.75;}
    focus-ring {
        width 4
        active-color "#86ade0"
        inactive-color "#505050"
    }
    border {off;}
}

hotkey-overlay {skip-at-startup;}

prefer-no-csd

screenshot-path "~/Pictures/屏幕截图 %Y年%m月%d日 %H:%M:%S.png"

animations {
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.00001
    }
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    QT_IM_MODULE                 "fcitx"
    QT_IM_MODULES                "wayland;fcitx"
    SDL_VIDEO_DRIVER             "wayland"
    XMODIFIERS                   "@im=fcitx"
}

spawn-at-startup "waybar"
spawn-at-startup "swaybg" "-i" "/home/huaji2369/.config/resource/BlackWhite.png"
spawn-at-startup "swayidle" "timeout" "600" "swaylock" "timeout" "900" "niri msg action power-off-monitors"
spawn-at-startup "gentoo-pipewire-launcher"
spawn-at-startup "FlClash"
spawn-at-startup "fcitx5"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"

include "window-rules.kdl"

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#00ff00"
        inactive-color "#080"
    }

    border {
        inactive-color "#080"
    }

    shadow {
        color "#0f08"
    }

    tab-indicator {
        active-color "#0f0"
        inactive-color "#080"
    }
}

include "binds.kdl"
